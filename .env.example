# Copy to .env (gitignored) and replace every value. Never commit .env.
# Placeholders marked REPLACE_ME are invalid on purpose: the app refuses to
# start until they are set.

# ---- App ----
# Host port published by docker compose.
APP_PORT=8080
# debug | release | test. Docker Compose always sets release.
GIN_MODE=release
# Maximum request body in bytes (2 GiB, sized for video uploads).
MAX_BODY_BYTES=2147483648
# Time allowed for in-flight requests on shutdown.
SHUTDOWN_TIMEOUT=15s

# ---- Secrets ----
# Master key (KEK) that wraps every data key: base64 of 32 random bytes.
# Generate with: make gen-key
MASTER_KEY=REPLACE_ME
# At least 32 characters. Generate with: make gen-key
SESSION_SECRET=REPLACE_ME

# ---- MongoDB ----
# Use URL-safe characters only; the password is embedded in MONGO_URI.
MONGO_ROOT_USERNAME=securestore
MONGO_ROOT_PASSWORD=change-me-mongo-password
MONGO_DATABASE=securestore

# ---- MinIO ----
# Password must be at least 8 characters.
MINIO_ROOT_USER=securestore
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_BUCKET=securestore

# ---- Only for `make run` outside Docker ----
# Requires docker-compose.override.yml so MongoDB and MinIO listen on
# 127.0.0.1. Docker Compose sets these itself for the app container.
MONGO_URI=mongodb://securestore:change-me-mongo-password@127.0.0.1:27017/?authSource=admin
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=securestore
MINIO_SECRET_KEY=change-me-minio-password
MINIO_USE_SSL=false
